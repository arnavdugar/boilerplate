{
  "name": "app-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm run typecheck && vite build && tsc -p tsconfig.worker.json",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-ts",
    "preview": "vite preview",
    "test:worker": "tsc -p tsconfig.worker.json && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^10.75.0",
    "@tanstack/preact-query": "^5.104.0",
    "@vanilla-extract/css": "^1.21.2",
    "preact": "^10.27.2",
    "wouter-preact": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@preact/preset-vite": "^2.10.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vite-pwa/assets-generator": "^1.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
