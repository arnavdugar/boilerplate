{
  "name": "app-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm run typecheck && vite build && tsc -p tsconfig.worker.json",
    "dev": "vite",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "generate:api": "openapi-ts",
    "lint": "eslint --max-warnings 0 .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run tests/worker.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^11.9.0",
    "@tanstack/preact-query": "^5.105.0",
    "@vanilla-extract/css": "^1.21.3",
    "preact": "^11.0.2",
    "wouter-preact": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@preact/preset-vite": "^2.10.6",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-sql-cst": "0.23.1",
    "prettier-plugin-yaml": "1.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
