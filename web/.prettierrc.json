{
  "importOrder": [
    "^preact(?:/.*)?$",
    "",
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^(?!.*\\.css(?:\\.ts)?$)@/",
    "",
    "^(?!.*\\.css(?:\\.ts)?$)\\.",
    "",
    "\\.css(?:\\.ts)?$"
  ],
  "importOrderSafeSideEffects": ["^@/styles\\.css$"],
  "importOrderTypeScriptVersion": "5.9.3",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "printWidth": 100,
  "proseWrap": "always",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all"
}
